.{
    .name = .arsip,
    .version = "0.0.0",
    .fingerprint = 0x11cbb62cbaca49e8, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",

    // nilo by path, because this project lives inside the repository it is
    // testing. A real dependent writes
    // `zig fetch --save git+https://github.com/nevindra/nilo?ref=v0.2.0`
    // instead, and gets the same package: whatever `.paths` in nilo's own
    // `build.zig.zon` lists, and nothing else. That is the point of consuming
    // it from out here rather than adding a ninth example — a file this app
    // cannot see is a file a dependent cannot see either.
    .dependencies = .{
        .nilo = .{ .path = "../.." },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
