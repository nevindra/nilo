.{
    .name = .nilo,
    .version = "0.8.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0xa9fef7e1c22a71e4,
    .dependencies = .{
        // A commit on zio's `main` rather than a tag: `main` is where zio's
        // `std.Io` is ported to Zig 0.17 (`af9af4b`), and every tag so far,
        // v0.19.1 included, is the 0.16 line, which fails on 0.17's `Io`
        // (`processReplacePath`, `net_send`). It carries `spawnInto`
        // (zio#761) and the fixes for zio#744 and zio#745. Move to the first
        // tag cut from it.
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio?ref=main#3bbd74d68a889e5d4da7274afdc7c7617ec614d6",
            .hash = "zio-0.19.0-xHbVVMFBLACx1T0028HttNTseV6bDeL0AI4id51AHx57",
        },
        // The driver behind `nilo_sql`, and lazy on purpose: it brings four
        // transitive dependencies of its own (buffer, metrics, xsync, tls),
        // and a project that serves HTTP and never imports the SQL module
        // should not fetch, build or link any of them (ADR 036).
        //
        // **`.lazy = true` is half of that and the smaller half.** It stops
        // Zig fetching this package while reading the manifest; it does
        // nothing about `build.zig` asking for it, and `b.lazyDependency`
        // *asks* — it answers null on the pass that finds the package missing
        // and enqueues the download. So the calls sit behind `-Dsql`, which is
        // off for a dependent until they pass `.sql = true`. ADR 066 is where
        // that was found, a year after the sentence above was published.
        //
        // lalinsky's `master`, which carries the two fixes nilo ran a fork
        // for: startup_parameters reach the server (`2907296`), and a cached
        // statement stops paying a second round trip (`2c7c6ca`,
        // `bench/result/sql.md` §16).
        //
        // **A fork's commit, for now**: that `master` (`7b4609c`) plus one
        // commit that builds it on Zig 0.17, lalinsky/pg.zig#23. It ports the
        // struct-of-arrays `@typeInfo`, moves metrics.zig to `ac16729`
        // (`6de29b8` reads `b.args`, which 0.17 removed), and xsync to a
        // commit whose mutexes lock uncancelably (lalinsky/xsync.zig#1). Once
        // both are merged, the pin goes back to lalinsky's.
        .pg = .{
            .url = "git+https://github.com/nevindra/pg.zig#c205ebd42f9b127217bc2335a9305a37a2a65f43",
            .hash = "pg-0.0.0-Wp_7ge3_BgBnXMGhh8vmjN-h6lvErBevna9ZZZXppMp4",
            .lazy = true,
        },
        // The other driver behind `nilo_sql`, and lazy for the same reason.
        // Unlike pg.zig it brings **no dependencies of its own** — it bundles
        // and statically links the SQLite amalgamation, which is what makes it
        // the whole of the C question rather than the start of it
        // (ADR 064). Three files and 47 KB of Zig over the top, which is also
        // the answer to "what if it stops": `sql/wire.zig` is a seam, and one
        // file gets rewritten rather than every call site.
        .zqlite = .{
            .url = "git+https://github.com/karlseguin/zqlite.zig#865223b734a5113f731ab1eb1d7d81c8ac252913",
            .hash = "zqlite-0.0.1-RWLaY4Y8nADz2l5aBE-JVyDyM3sZzHjq0agNykuVZKqQ",
            .lazy = true,
        },
        // The TLS 1.3 server behind `-Dtls` (ADR 212), and lazy for the
        // reason the drivers are: a program that never asks fetches nothing.
        // Pure Zig on `std.crypto`, no C, and pinned to a commit rather than
        // a tag, because it has no tags. The commit, not the branch, is the
        // pin.
        //
        // **A fork's commit, for now**: upstream's `main` (the Zig 0.17 line)
        // plus two commits. One signs with the key's CRT form, which takes an
        // RSA-2048 handshake from 13.7 to 2.6 ms of server CPU
        // (bench/result/http.md, "What an RSA certificate costs a
        // handshake"); it is ianic/tls.zig#59 on `zig-0.16.x` and #61 on
        // `main`. The other adds the server's `offload` option, which the
        // Engine uses to sign on the blocking pool (ADR 217), and is #62.
        // Once both are upstream, the pin goes back to it and the fork is not
        // used again.
        .tls = .{
            .url = "git+https://github.com/nevindra/tls.zig#1d1dda2eccec9ddb83d906b4628a3fa9c4c3112b",
            .hash = "tls-0.1.0-ER2e0njeBgD84olLeuyJgyoY5eesJk9y1bD4UCzsEtSd",
            .lazy = true,
        },
        // libdeflate's compressor behind `-Dlibdeflate` (ADR 248), lazy and
        // behind its flag for the reason the drivers are. The upstream
        // release tarball, compiled by `build.zig` itself rather than through
        // a Zig wrapper package, so a Zig release changes nothing here: the
        // one wrapper that exists pinned 1.18 and left `crc32.c` out.
        .libdeflate = .{
            .url = "https://github.com/ebiggers/libdeflate/archive/refs/tags/v1.26.tar.gz",
            .hash = "N-V-__8AAEaRCwCsYb_rSsH72Pb6DNFQLSjdRzTFOVsJWcoB",
            .lazy = true,
        },
        // Node's HTTP parser, as a second reading of RFC 9112 for
        // `zig build fuzz-llhttp` (ADR 231), and linked into nothing else.
        // C, so it waits behind `-Dllhttp` as well as `.lazy`. A release
        // tarball rather than the repository: the parser in `src/` is
        // generated, and only the release branch carries it.
        .llhttp = .{
            .url = "https://github.com/nodejs/llhttp/archive/refs/tags/release/v9.4.3.tar.gz",
            .hash = "N-V-__8AANkgBgCZosn_JabRa_Pm-AMJtzCRfMWzALMRadIE",
            .lazy = true,
        },
    },
    // One directory per module that ships (ADR 038), and this list is the
    // one place that has to remember they exist — held by a comptime check
    // in `build.zig`, because a dependent whose package is missing a
    // directory finds out at their own build rather than ours.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "core",
        "id",
        "config",
        "pw",
        "cache",
        "jwt",
        "proto",
        "fetch",
        "job",
        "http",
        "sql",
        "s3",
        "dev",
        "template",
        "LICENSE",
        "README.md",
    },
}
