+pub fn differential(gpa: std.mem.Allocator) !void {
+    var prng = std.Random.DefaultPrng.init(0x5eed);
+    const rnd = prng.random();
+    var stats = [_]usize{0} ** 4;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    var buf: [1024]u8 = undefined;
+    const json = @import("json.zig");
+    var n: usize = 0;
+    const alphabet = "{}[]\",:0123456789-+.eE tfnul\\/ux\x00\xff";
+    while (n < 400_000) : (n += 1) {
+        const seed = seeds[n % seeds.len];
+        @memcpy(buf[0..seed.len], seed);
+        var len = seed.len;
+        const edits = rnd.uintLessThan(usize, 4);
+        for (0..edits) |_| {
+            if (len == 0) break;
+            const at = rnd.uintLessThan(usize, len);
+            switch (rnd.uintLessThan(usize, 4)) {
+                0 => buf[at] = alphabet[rnd.uintLessThan(usize, alphabet.len)],
+                1 => {
+                    std.mem.copyForwards(u8, buf[at .. len - 1], buf[at + 1 .. len]);
+                    len -= 1;
+                },
+                2 => if (len < buf.len) {
+                    std.mem.copyBackwards(u8, buf[at + 1 .. len + 1], buf[at..len]);
+                    buf[at] = alphabet[rnd.uintLessThan(usize, alphabet.len)];
+                    len += 1;
+                },
+                else => len = at,
+            }
+        }
+        const input = buf[0..len];
+        const a = json.parseLeakyStd(Doc, arena.allocator(), input, .{});
+        const b = @import("jsonread.zig").parse(Doc, arena.allocator(), input, .{});
+        same(Doc, b, a, &stats) catch |e| {
+            std.debug.print("input: {s}\n", .{input});
+            return e;
+        };
+        const c = json.parseLeakyStd(Shot, arena.allocator(), input, .{});
+        const d = parse(Shot, arena.allocator(), input, .{});
+        same(Shot, d, c, &stats) catch |e| {
+            std.debug.print("input (Shot): {s}\n", .{input});
+            return e;
+        };
+        _ = arena.reset(.{ .retain_with_limit = 1 << 20 });
+    }
+    std.debug.print("differential: {d} equal reads, {d} refusals by both ({d} named differently)\n", .{ stats[0], stats[1], stats[2] });
+}
