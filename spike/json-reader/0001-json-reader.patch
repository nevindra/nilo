+var pairs: [64][2]u16 = undefined;
+var npairs: usize = 0;
+
+fn same(comptime T: type, a: Error!T, b: Error!T, stats: *[4]usize) !void {
+    if (a) |x| {
+        if (b) |y| {
+            stats[0] += 1;
+            try std.testing.expectEqualDeep(x, y);
+        } else |e| {
+            std.debug.print("std refused what direct read: {s}\n", .{@errorName(e)});
+            return error.Mismatch;
+        }
+    } else |ea| {
+        if (b) |_| {
+            std.debug.print("direct refused what std read: {s}\n", .{@errorName(ea)});
+            return error.Mismatch;
+        } else |eb| {
+            stats[1] += 1;
+            if (ea != eb) {
+                stats[2] += 1;
+                var known = false;
+                for (pairs[0..npairs]) |pr| if (pr[0] == @intFromError(ea) and pr[1] == @intFromError(eb)) {
+                    known = true;
+                };
+                if (!known and npairs < pairs.len) {
+                    pairs[npairs] = .{ @intFromError(ea), @intFromError(eb) };
+                    npairs += 1;
+                    std.debug.print("  direct {s} / std {s}\n", .{ @errorName(ea), @errorName(eb) });
+                }
+            }
+        }
+    }
+}
