// Pinned to exactly what ../../build.zig.zon pins, so this spike measures the
// version nilo actually ships against rather than whatever is newest. That
// matters more here than usual: the number this produces is meant to go into
// an ADR, and an ADR's number has to be reproducible from the pin.
.{
    .name = .mailbox_spike,
    .version = "0.0.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x6585424a3055647d,
    .dependencies = .{
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio?ref=v0.17.0#9711d68104946a457f151776000210d8adca3f3e",
            .hash = "zio-0.17.0-xHbVVI_jJQC3YbgU7JydwAV7MuASkOTd73YqBaKlFFUz",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "main.zig" },
}
